PROJECT_NAME="AdaptFlow Multimodal Knowledge Base"
API_V1_STR="/api/v1"
DEBUG=true

# Storage settings
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=500

# Parsing settings
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
VIDEO_INTERVAL_SECONDS=30.0

# Supported modalities
ALLOWED_TEXTBOOK_EXTENSIONS=[".pdf", ".epub"]
ALLOWED_VIDEO_EXTENSIONS=[".mp4", ".mkv", ".mov", ".webm", ".avi"]
ALLOWED_SLIDE_EXTENSIONS=[".pptx", ".ppt", ".pdf", ".key"]
