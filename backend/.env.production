# AdaptFlow Backend - Production Environment
PROJECT_NAME="AdaptFlow Backend"
API_V1_STR="/api/v1"
DEBUG=false
VERSION="2.0.0"

# Database (overridden by docker-compose environment)
DATABASE_URL=postgresql+asyncpg://adaptflow:CHANGE_ME@postgres:5432/adaptflow
DATABASE_URL_SYNC=postgresql+psycopg2://adaptflow:CHANGE_ME@postgres:5432/adaptflow

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT Auth — MUST change in production
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — set to your production frontend domain
CORS_ORIGINS=["https://adaptflow.example.com"]
FRONTEND_URL=https://adaptflow.example.com

# Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# Parsing
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
VIDEO_INTERVAL_SECONDS=30.0

# AI Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DIMENSION=384
RETRIEVAL_MIN_SIMILARITY=0.75

# Rate Limiting
RATE_LIMIT_STANDARD=60
RATE_LIMIT_LLM=10
